SERVER_BE=/be
SERVER_STATIC=/static
# Private bases used by SSR fetches and the runtime frontend proxy.
SERVER_INTERNAL_BE=http://localhost:1323
SERVER_INTERNAL_STATIC=http://localhost:1323/static
PUBLIC_DISCORD_CLIENT_ID=
SERVER_DISCORD_CLIENT_SECRET=

# For Discord Activities, the pathnames in SERVER_BE and SERVER_STATIC should
# match Activity URL Mapping prefixes, for example /be and /static.

# Backend
ADDR=:1323
OUTPUT=./output
JOBS_CACHE_TTL=15m
MAX_PFP_BYTES=12000000
PFP_DIR=./data/pfp
MEDIA_CACHE_DIR=./cache/media

# Optional local NVIDIA encoding for Plex. Originals remain read-only.
ENCODE_ENABLED=false
FFMPEG=ffmpeg
FFPROBE=ffprobe
ENCODE_QUALITY=22
ENCODE_PRESET=p7
ENCODE_AUDIO_KBPS=144
ENCODE_CONCURRENCY=2
ENCODE_CACHE_BYTES=21474836480
ENCODE_CACHE_TTL=24h

# Optional read-only Plex catalog and original files. Keep the token server-side.
PLEX_URL=http://192.168.1.177:32400
PLEX_TOKEN=
PLEX_LIBRARY_IDS=1,11,17,2,12,3,13
# JSON uses forward slashes on Windows. The local root must already exist.
PLEX_PATH_MAPPINGS='[{"plex":"/data/Managed-Videos","local":"O:/Managed-Videos"}]'
