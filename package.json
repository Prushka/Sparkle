{
	"name": "sparkle-fe",
	"version": "0.0.1",
	"scripts": {
		"predev": "node scripts/prepare-player-assets.mjs && node scripts/generate-sw.mjs --dev",
		"prebuild": "node scripts/prepare-player-assets.mjs",
		"prepare:player": "node scripts/prepare-player-assets.mjs",
		"test:e2e": "playwright test",
		"test:player": "node scripts/tests/subtitle-bitmap.mjs && node scripts/tests/subtitle-rendering.mjs && node scripts/tests/track-selection.mjs && node scripts/tests/hdr-policy.mjs && node scripts/tests/hdr-metadata.mjs && node scripts/tests/encoded-policy.mjs && node scripts/tests/raw-fullscreen.mjs && node scripts/tests/playback-operation.mjs && node scripts/tests/raw-native-subtitles.mjs && node scripts/tests/playback-bitrate.mjs && node scripts/tests/audio-normalization.mjs && node scripts/tests/plex-preview.mjs",
		"test:audio": "node scripts/prepare-player-assets.mjs && node scripts/tests/qualify-audio-normalization.mjs",
		"test:surround": "node scripts/prepare-player-assets.mjs && node scripts/tests/audio-output.mjs && node scripts/tests/qualify-surround-audio.mjs",
		"dev": "next dev --webpack --hostname 0.0.0.0 -p 3001",
		"build": "next build --webpack && node scripts/generate-sw.mjs",
		"start": "next start",
		"check": "tsc --noEmit",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"generate:wordle-dictionary": "node scripts/generate-wordle-dictionary.mjs"
	},
	"type": "module",
	"dependencies": {
		"@base-ui/react": "1.8.0",
		"@discord/embedded-app-sdk": "^2.5.0",
		"@libmedia/avplayer": "1.3.1",
		"@radix-ui/react-dialog": "^1.1.23",
		"@radix-ui/react-dropdown-menu": "^2.1.24",
		"@radix-ui/react-popover": "^1.1.23",
		"@radix-ui/react-radio-group": "^1.4.7",
		"@radix-ui/react-separator": "^1.1.15",
		"@radix-ui/react-slider": "^1.4.7",
		"@radix-ui/react-slot": "^1.3.3",
		"@radix-ui/react-tooltip": "^1.2.16",
		"@tabler/icons-react": "^3.48.0",
		"@tanstack/react-virtual": "3.14.13",
		"@vidstack/react": "^1.15.6",
		"cheerio": "^1.2.0",
		"chess.js": "^1.4.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"jassub": "^2.5.16",
		"loudness-worklet": "2.0.3",
		"motion": "^13.4.6",
		"next": "^16.3.8",
		"radix-ui": "^1.6.7",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"slate": "^0.126.2",
		"slate-history": "^0.113.1",
		"slate-react": "^0.127.1",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/eslint": "^9.6.1",
		"@types/node": "^26.6.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"an-array-of-english-words": "^2.0.0",
		"autoprefixer": "^10.6.1",
		"dictionary-en": "^4.0.0",
		"esbuild": "0.28.2",
		"eslint": "^9.39.5",
		"eslint-config-next": "^16.3.8",
		"eslint-config-prettier": "^10.1.8",
		"postcss": "^8.5.28",
		"prettier": "^3.9.9",
		"sharp": "0.35.5",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"word-list": "^4.1.0",
		"wordlist-english": "^1.2.1"
	}
